{
  "name": "@yosnightfly/electra-smart-js-client",
  "version": "1.0.7",
  "description": "Electra Smart JS Client",
  "files": [
    "lib"
  ],
  "bin": {
    "electra-smart-js-client": "./lib/index.js"
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "prepare": "node scripts/prepare-husky.js",
    "build": "rm -rf lib tsconfig.build.tsbuildinfo && tsc6 -p tsconfig.build.json",
    "prepack": "npm run build && test -f lib/index.js && test -f lib/index.d.ts",
    "start": "ts-node src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "ci": "npm run format:check && npm run lint:check && npm test && npm run build && npm run package:check",
    "package:check": "node scripts/check-package.js",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@jest/types": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "minimatch": "^10.2.5",
    "prettier": "^3.9.6",
    "test-exclude": "^8.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "brace-expansion@^1.1.7": "1.1.16",
    "brace-expansion@^2.0.2": "2.1.2",
    "brace-expansion@^5.0.5": "5.0.8",
    "fast-uri": "^3.1.4",
    "js-yaml": "^4.3.0",
    "tar": "^7.5.10"
  },
  "author": "Yossi Hillali",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hillaliy/electra-smart-js-client/issues"
  },
  "homepage": "https://github.com/hillaliy/electra-smart-js-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hillaliy/electra-smart-js-client.git"
  },
  "keywords": [
    "electra",
    "smart",
    "ac",
    "air conditioning",
    "IOT"
  ]
}
